{"size":1,"totalSize":1,"done":true,"queryLocator":null,"entityTypeName":"ApexClass","records":[{"attributes":{"type":"ApexClass","url":"/services/data/v52.0/tooling/sobjects/ApexClass/01pGA00000Xyp6bYAB"},"Body":"/**\n * @description       : \n * @group             : \n * @last modified on  : 04-02-2024\n**/\npublic with sharing class DqeAddressController {\n    @AuraEnabled\n    public static Map<String,Object> getData(String profileValue){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            List<LabelWrapper> labelWrapper= new List<LabelWrapper>();\n            List<String> profileIds= new List<String>();\n            String orgId='';            \n            String selectedId = profileValue;\n            Organization org=[Select id,name from Organization];\n            orgId=org.Id;\n            List<DQE_Address_Setup__c> setups= new List<DQE_Address_Setup__c>();\n            List<DQE_Address_Setup__c> dess = [SELECT Id, SetupOwnerId, Address_Complement_Field__c, \n                                               Address_Sublocality_Field__c, Autofill_Address_Complement__c, \n                                               Default_Country__c, Display_Maps_On_Creation__c, Display_Maps_On_Edition__c,\n                                               Geolocate__c, Quality_Code_Fields__c,FieldsControled__c \n                                               FROM DQE_Address_Setup__c];\n            \n            for(DQE_Address_Setup__c ess : dess)\n            {\n                if(orgId==ess.SetupOwnerId)\n                {\n                    LabelWrapper orgTemp =new LabelWrapper();\n                    orgTemp.label='Standard';\n                    orgTemp.value=ess.SetupOwnerId;\n                    labelWrapper.add(orgTemp);\n                    if(String.isBlank(profileValue) || profileValue==ess.SetupOwnerId)\n                    {\n                        selectedId = ess.SetupOwnerId;\n                        setups.add(ess);\n                    }\n                }\n                else\n                {\n                    profileIds.add(ess.SetupOwnerId);\n                    if(profileValue==String.valueOf(ess.SetupOwnerId))\n                    {\n                        setups.add(ess);\n                    }\n                }\n            }\n\n\n            \n\n            List<Profile> profiles=[Select id,name from Profile where Id in :profileIds];\n\n\n            List<Profile> profilesNotUsed=[Select id,name from Profile where Id Not in :profileIds];\n\n            List<LabelWrapper> newProfiles = new List<LabelWrapper>();\n\n            for(Profile prof:profilesNotUsed)\n            {\n                LabelWrapper orgTemp =new LabelWrapper();\n                orgTemp.label=prof.Name;\n                orgTemp.value=prof.Id;\n                newProfiles.add(orgTemp);\n            }\n\n            for(Profile prof:profiles)\n            {\n                LabelWrapper orgTemp =new LabelWrapper();\n                orgTemp.label=prof.Name;\n                orgTemp.value=prof.Id;\n                labelWrapper.add(orgTemp);\n            }\n            \n            List<DataWrapper> addressComplementFieldData = new List<DataWrapper>();\n            List<DataWrapper> addressSublocalityFieldData = new List<DataWrapper>();\n            List<DataWrapper> qualityCodeFieldsData = new List<DataWrapper>();\n            List<DataWrapperTwoFields> fieldsControledData = new List<DataWrapperTwoFields>();\n            \n\n            for(DQE_Address_Setup__c se:setups)\n            {\n                List<String> blockingCodes=new List<String>();\n                if(String.isNotBlank(se.FieldsControled__c))\n                {\n                    List<String> tempList=se.FieldsControled__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapperTwoFields tempWrapper=new DataWrapperTwoFields();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        fieldsControledData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                if(String.isNotBlank(se.Address_Complement_Field__c))\n                {\n                    List<String> tempList=se.Address_Complement_Field__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapper tempWrapper=new DataWrapper();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        tempWrapper.field3=singleInstance.size()>=3?singleInstance[2].trim():'';\n                        addressComplementFieldData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                if(String.isNotBlank(se.Address_Sublocality_Field__c))\n                {\n                    List<String> tempList=se.Address_Sublocality_Field__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapper tempWrapper=new DataWrapper();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        tempWrapper.field3=singleInstance.size()>=3?singleInstance[2].trim():'';\n                        addressSublocalityFieldData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                if(String.isNotBlank(se.Quality_Code_Fields__c))\n                {\n                    List<String> tempList=se.Quality_Code_Fields__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapper tempWrapper=new DataWrapper();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        tempWrapper.field3=singleInstance.size()>=3?singleInstance[2].trim():'';\n                        qualityCodeFieldsData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                returnMap.put('autoFillAddressComplement',se.Autofill_Address_Complement__c);\n                returnMap.put('displayMapsOnCreation',se.Display_Maps_On_Creation__c);\n                returnMap.put('displayMapsOnEdition',se.Display_Maps_On_Edition__c);\n                returnMap.put('geoLocate',se.Geolocate__c);\n                returnMap.put('defaultCountry',se.Default_Country__c);\n                \n            }\n            //orgId\n            //all id and label mapping\n            returnMap.put('orgId',orgId);\n            returnMap.put('selectedId',selectedId);\n            returnMap.put('labelWrapper',labelWrapper);\n            returnMap.put('newProfiles',newProfiles);\n            returnMap.put('addressComplementFieldData',addressComplementFieldData);\n            returnMap.put('addressSublocalityFieldData',addressSublocalityFieldData);\n            returnMap.put('qualityCodeFieldsData',qualityCodeFieldsData);\n            returnMap.put('fieldsControledData',fieldsControledData);\n\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n            returnMap.put('errorMessage',e.getStackTraceString());\n            //throw new AuraHandledException(e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> updateRecords(Map<String,String> dataMap,String field){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try \n        {\n            System.debug(JSON.serialize(dataMap));\n            List<DQE_Address_Setup__c> sObjects=new List<DQE_Address_Setup__c> ();\n            for(String key:dataMap.keySet())\n            {\n                DQE_Address_Setup__c temp = new DQE_Address_Setup__c(); \n                temp.Id=key;\n                if(field.equalsIgnoreCase('FieldsControled__c'))\n                {\n                    returnMap = ObjectUtil.checkFieldViability(dataMap.get(key));\n                    if(!Boolean.valueOf(returnMap.get('success')))\n                    {\n                        return returnMap;\n                    }\n                }\n                temp.put(field,dataMap.get(key));\n                sObjects.add(temp);\n            }\n            update sObjects;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> updateToggle(String setupOwnerId,String field,Boolean value){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            DQE_Address_Setup__c des = [Select id from DQE_Address_Setup__c where SetupOwnerId=:setupOwnerId LIMIT 1];\n            DQE_Address_Setup__c temp = new DQE_Address_Setup__c();\n            temp.id = des.Id;\n            temp.put(field,value);\n            update temp;\n            \n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> updateText(String setupOwnerId,String field,String value){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            DQE_Address_Setup__c des = [Select id from DQE_Address_Setup__c where SetupOwnerId=:setupOwnerId LIMIT 1];\n            DQE_Address_Setup__c temp = new DQE_Address_Setup__c();\n            temp.id = des.Id;\n            temp.put(field,value);\n            update temp;\n            \n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> insertNewLine(String field,String selectedProfile){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            String query = 'Select id,SetupOwnerId,'+field+' from DQE_Address_Setup__c where SetupOwnerId=\\''+selectedProfile+'\\' LIMIT 1';\n            List<DQE_Address_Setup__c> addresses=Database.query(query);\n            DQE_Address_Setup__c address = addresses[0];\n            if(field.equalsIgnoreCase('FieldsControled__c'))\n            {\n                address.put(field,String.isBlank(String.valueOf(address.get(field)))?' - ':(String.valueOf(address.get(field))+'\\r\\n - '));\n            }\n            else\n            {\n                address.put(field,String.isBlank(String.valueOf(address.get(field)))?' - - ':(String.valueOf(address.get(field))+'\\r\\n - - '));\n            }\n            System.debug(JSON.serialize(addresses));\n            System.debug('email : '+JSON.serialize(address));\n            update address;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n\n    @AuraEnabled\n    public static Map<String,Object> updateField(String id,String field,String updatedValue){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            DQE_Address_Setup__c temp = new DQE_Address_Setup__c();\n            temp.id=id;\n            temp.put(field,updatedValue);\n            update temp;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n\n    @AuraEnabled\n    public static Map<String,Object> saveNewRecord(List<String> ids){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            List<String> idList = ids;\n            List<DQE_Address_Setup__c> addressSetup = new List<DQE_Address_Setup__c>();\n            for(String id:idList)\n            {\n                DQE_Address_Setup__c temp = new DQE_Address_Setup__c();\n                temp.SetupOwnerId = id;\n                addressSetup.add(temp);\n            }\n            if(!addressSetup.isEmpty())\n                insert addressSetup;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    public class DataWrapperTwoFields{\n        @AuraEnabled\n        public String id;\n        @AuraEnabled\n        public String field1;\n        @AuraEnabled\n        public String field2;\n    }\n\n    public class DataWrapper{\n        @AuraEnabled\n        public String id;\n        @AuraEnabled\n        public String field1;\n        @AuraEnabled\n        public String field2;\n        @AuraEnabled\n        public String field3;\n    }\n\n    public class LabelWrapper{\n        @AuraEnabled\n        public String label;\n        @AuraEnabled\n        public String value;\n    }\n}"}]}