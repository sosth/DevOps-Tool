{"size":1,"totalSize":1,"done":true,"queryLocator":null,"entityTypeName":"ApexClass","records":[{"attributes":{"type":"ApexClass","url":"/services/data/v52.0/tooling/sobjects/ApexClass/01pGA00000XyimZYAR"},"Body":"/**\n * @description       : \n * @group             : \n * @last modified on  : 03-04-2024\n**/\npublic with sharing class DqeEmailController {\n     \n    @AuraEnabled\n    public static Map<String,Object> getData(String profileValue){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            List<LabelWrapper> labelWrapper= new List<LabelWrapper>();\n            List<String> profileIds= new List<String>();\n            String orgId='';            \n            String selectedId = profileValue;\n            Organization org=[Select id,name from Organization];\n            orgId=org.Id;\n            List<DQE_Email_Setup__c> setups= new List<DQE_Email_Setup__c>();\n            List<DQE_Email_Setup__c> dess = [SELECT Id,SetupOwnerId,Blocking_Codes__c, Domain_Throwable_Code__c, \n                                                Unknown_Domain_Code__c, Syntax_Error_Code__c, User_Not_Verified_Code__c, \n                                                Valid_Email_Code__c, Invalid_Email_Code__c\n                                                ,Email_Quality_Fields__c,Email_Activity_Fields__c\n                                                ,Extented_Syntax__c, Suggest__c,FieldsControled__c\n                                                FROM DQE_Email_Setup__c];\n            \n            for(DQE_Email_Setup__c ess : dess)\n            {\n                System.debug('Id : '+ess.id);\n                System.debug('ess.SetupOwnerId : '+ess.SetupOwnerId);\n                if(orgId==ess.SetupOwnerId)\n                {\n                    LabelWrapper orgTemp =new LabelWrapper();\n                    orgTemp.label='Standard';\n                    orgTemp.value=ess.SetupOwnerId;\n                    labelWrapper.add(orgTemp);\n                    if(String.isBlank(profileValue) || profileValue==ess.SetupOwnerId)\n                    {\n                        selectedId = ess.SetupOwnerId;\n                        setups.add(ess);\n                    }\n                }\n                else\n                {\n                    profileIds.add(ess.SetupOwnerId);\n                    if(profileValue==String.valueOf(ess.SetupOwnerId))\n                    {\n                        setups.add(ess);\n                    }\n                }\n            }\n\n\n            \n\n            List<Profile> profiles=[Select id,name from Profile where Id in :profileIds];\n\n\n            List<Profile> profilesNotUsed=[Select id,name from Profile where Id Not in :profileIds];\n\n            List<LabelWrapper> newProfiles = new List<LabelWrapper>();\n\n            for(Profile prof:profilesNotUsed)\n            {\n                LabelWrapper orgTemp =new LabelWrapper();\n                orgTemp.label=prof.Name;\n                orgTemp.value=prof.Id;\n                newProfiles.add(orgTemp);\n            }\n\n            for(Profile prof:profiles)\n            {\n                LabelWrapper orgTemp =new LabelWrapper();\n                orgTemp.label=prof.Name;\n                orgTemp.value=prof.Id;\n                labelWrapper.add(orgTemp);\n            }\n            \n            List<DataWrapper> qualityData = new List<DataWrapper>();\n            List<DataWrapper> activityData = new List<DataWrapper>();\n            List<GeneralWrapper> generalData = new List<GeneralWrapper>();\n            List<DataWrapperTwoFields> fieldsControledData = new List<DataWrapperTwoFields>();\n\n            for(DQE_Email_Setup__c se:setups)\n            {\n                List<String> blockingCodes=new List<String>();\n                if(String.isNotBlank(se.Blocking_Codes__c))\n                {\n                    blockingCodes=se.Blocking_Codes__c.split(',');\n                }\n                if(String.isNotBlank(se.FieldsControled__c))\n                {\n                    List<String> tempList=se.FieldsControled__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapperTwoFields tempWrapper=new DataWrapperTwoFields();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        fieldsControledData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                if(String.isNotBlank(se.Email_Quality_Fields__c))\n                {\n                    List<String> tempList=se.Email_Quality_Fields__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapper tempWrapper=new DataWrapper();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        tempWrapper.field3=singleInstance.size()>=3?singleInstance[2].trim():'';\n                        qualityData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                if(String.isNotBlank(se.Email_Activity_Fields__c))\n                {\n                    List<String> tempList=se.Email_Activity_Fields__c.split('\\\\r\\\\n');\n                    Integer count=0;\n                    for(String temp:tempList)\n                    {\n                        DataWrapper tempWrapper=new DataWrapper();\n                        List<String> singleInstance=temp.split('-');\n                        tempWrapper.id=se.Id+'+'+count;\n                        tempWrapper.field1=singleInstance.size()>=1?singleInstance[0].trim():'';\n                        tempWrapper.field2=singleInstance.size()>=2?singleInstance[1].trim():'';\n                        tempWrapper.field3=singleInstance.size()>=3?singleInstance[2].trim():'';\n                        activityData.add(tempWrapper);\n                        count++;\n                    }\n                }\n                // if(String.isNotBlank(se.Domain_Throwable_Code__c))\n                    generalData.add(createGeneralWrapper(se,'Domain_Throwable_Code__c',Label.DomainThrowable,se.Domain_Throwable_Code__c,blockingCodes));\n                //if(String.isNotBlank(se.Unknown_Domain_Code__c))\n                    generalData.add(createGeneralWrapper(se,'Unknown_Domain_Code__c',Label.UnknownDomain,se.Unknown_Domain_Code__c,blockingCodes));\n                //if(String.isNotBlank(se.Syntax_Error_Code__c))\n                    generalData.add(createGeneralWrapper(se,'Syntax_Error_Code__c',Label.SyntaxError,se.Syntax_Error_Code__c,blockingCodes));\n                //if(String.isNotBlank(se.User_Not_Verified_Code__c))\n                    generalData.add(createGeneralWrapper(se,'User_Not_Verified_Code__c',Label.UserNotVerified,se.User_Not_Verified_Code__c,blockingCodes));\n                //if(String.isNotBlank(se.Valid_Email_Code__c))\n                    generalData.add(createGeneralWrapper(se,'Valid_Email_Code__c',Label.ValidEmail,se.Valid_Email_Code__c,blockingCodes));\n                //if(String.isNotBlank(se.Invalid_Email_Code__c))\n                    generalData.add(createGeneralWrapper(se,'Invalid_Email_Code__c',Label.InvalidEmail,se.Invalid_Email_Code__c,blockingCodes));\n                returnMap.put('acceptExtendedSyntax',se.Extented_Syntax__c);\n                returnMap.put('suggestUsername',se.Suggest__c);\n                \n            }\n            //orgId\n            //all id and label mapping\n            returnMap.put('orgId',orgId);\n            returnMap.put('selectedId',selectedId);\n            returnMap.put('labelWrapper',labelWrapper);\n            returnMap.put('newProfiles',newProfiles);\n            returnMap.put('qualityData',qualityData);\n            returnMap.put('activityData',activityData);\n            returnMap.put('generalData',generalData);\n            returnMap.put('fieldsControledData',fieldsControledData);\n\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n            returnMap.put('errorMessage',e.getStackTraceString());\n            //throw new AuraHandledException(e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> saveGeneralData(Map<String,Map<String,String>> dataMap){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            List<DQE_Email_Setup__c> ess=new List<DQE_Email_Setup__c> ();\n            for(String k : dataMap.keySet())\n            {\n                DQE_Email_Setup__c temp = new DQE_Email_Setup__c();\n                temp.id=k;\n                for(String field:dataMap.get(k).keySet())\n                {\n                    temp.put(field,dataMap.get(k).get(field));\n                }\n                ess.add(temp);\n            }\n            update ess;\n            \n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n\n    }\n\n    public static GeneralWrapper createGeneralWrapper(DQE_Email_Setup__c se,String idAppend,String label,String value,List<String> blockingCodes)\n    {\n        GeneralWrapper temp = new GeneralWrapper();\n        temp.Id = se.Id+'+'+idAppend;\n        temp.statusLabel = label;\n        temp.statusCode = value;\n        temp.preventSaving = blockingCodes.contains(value)?true:false;\n        return temp;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> updateRecords(Map<String,String> dataMap,String field){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            List<DQE_Email_Setup__c> sObjects=new List<DQE_Email_Setup__c> ();\n            for(String key:dataMap.keySet())\n            {\n                DQE_Email_Setup__c temp = new DQE_Email_Setup__c(); \n                temp.Id=key;\n                if(field.equalsIgnoreCase('FieldsControled__c'))\n                {\n                    returnMap = ObjectUtil.checkFieldViability(dataMap.get(key));\n                    if(!Boolean.valueOf(returnMap.get('success')))\n                    {\n                        return returnMap;\n                    }\n                }\n                temp.put(field,dataMap.get(key));\n                sObjects.add(temp);\n            }\n            update sObjects;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> updateToggle(String setupOwnerId,String field,Boolean value){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            DQE_Email_Setup__c des = [Select id from DQE_Email_Setup__c where SetupOwnerId=:setupOwnerId LIMIT 1];\n            DQE_Email_Setup__c temp = new DQE_Email_Setup__c();\n            temp.id = des.Id;\n            temp.put(field,value);\n            update temp;\n            \n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> saveNewRecord(List<String> ids){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            List<String> idList = ids;\n            List<DQE_Email_Setup__c> emailSetup = new List<DQE_Email_Setup__c>();\n            for(String id:idList)\n            {\n                DQE_Email_Setup__c temp = new DQE_Email_Setup__c();\n                temp.SetupOwnerId = id;\n                temp.Domain_Throwable_Code__c = StaticVariables.DOMAIN_THROWABLE_CODE;\n                temp.Unknown_Domain_Code__c = StaticVariables.UNKNOWN_DOMAIN_CODE;\n                temp.Syntax_Error_Code__c =StaticVariables.SYNTAX_ERROR_CODE;\n                temp.User_Not_Verified_Code__c = StaticVariables.USER_NOT_VERIFIED_CODE;\n                temp.Valid_Email_Code__c = StaticVariables.VALID_EMAIL_CODE;\n                temp.Invalid_Email_Code__c =StaticVariables.INVALID_EMAIL_CODE;\n                emailSetup.add(temp);\n            }\n            if(!emailSetup.isEmpty())\n                insert emailSetup;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    @AuraEnabled\n    public static Map<String,Object> insertNewLine(String field,String selectedProfile){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            String query = 'Select id,SetupOwnerId,'+field+' from DQE_Email_Setup__c where SetupOwnerId=\\''+selectedProfile+'\\' LIMIT 1';\n            List<DQE_Email_Setup__c> emails=Database.query(query);\n            DQE_Email_Setup__c email = emails[0];\n\n            if(field.equalsIgnoreCase('FieldsControled__c'))\n            {\n                email.put(field,String.isBlank(String.valueOf(email.get(field)))?' - ':(String.valueOf(email.get(field))+'\\r\\n - '));\n            }\n            else\n            {\n                email.put(field,String.isBlank(String.valueOf(email.get(field)))?' - - ':(String.valueOf(email.get(field))+'\\r\\n - - '));\n            }\n            System.debug(JSON.serialize(emails));\n            System.debug('email : '+JSON.serialize(email));\n            update email;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n    \n    @AuraEnabled\n    public static Map<String,Object> updateField(String id,String field,String updatedValue){\n        Map<String,Object> returnMap=new Map<String,Object>();\n        returnMap.put('success',true);\n        try {\n            DQE_Email_Setup__c temp = new DQE_Email_Setup__c();\n            temp.id=id;\n            temp.put(field,updatedValue);\n            update temp;\n        } catch (Exception e) {\n            returnMap.put('success',false);\n            returnMap.put('errorMessage',e.getMessage());\n        }\n        return returnMap;\n    }\n\n    public class DataWrapper{\n        @AuraEnabled\n        public String id;\n        @AuraEnabled\n        public String field1;\n        @AuraEnabled\n        public String field2;\n        @AuraEnabled\n        public String field3;\n    }\n\n    public class GeneralWrapper{\n        @AuraEnabled\n        public String id;\n        @AuraEnabled\n        public String statusCode;\n        @AuraEnabled\n        public String statusLabel;\n        @AuraEnabled\n        public Boolean preventSaving;\n    }\n\n    public class DataWrapperTwoFields{\n        @AuraEnabled\n        public String id;\n        @AuraEnabled\n        public String field1;\n        @AuraEnabled\n        public String field2;\n    }\n\n    public class LabelWrapper{\n        @AuraEnabled\n        public String label;\n        @AuraEnabled\n        public String value;\n    }\n}"}]}