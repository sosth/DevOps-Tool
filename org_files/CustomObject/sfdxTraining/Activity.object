{
  "fullName": "Activity",
  "actionOverrides": [
    {
      "actionName": "CancelEdit",
      "type": "Default"
    },
    {
      "actionName": "ComposeGmail",
      "type": "Default"
    },
    {
      "actionName": "LogCall",
      "type": "Default"
    },
    {
      "actionName": "MailMerge",
      "type": "Default"
    },
    {
      "actionName": "RequestUpdate",
      "type": "Default"
    },
    {
      "actionName": "SaveEdit",
      "type": "Default"
    },
    {
      "actionName": "SendEmail",
      "type": "Default"
    },
    {
      "actionName": "ViewAll",
      "type": "Default"
    }
  ],
  "enableFeeds": "false",
  "label": "Activity",
  "listViews": [
    {
      "fullName": "AllActivities",
      "filterScope": "Team",
      "label": "All Activities"
    },
    {
      "fullName": "MyActivities",
      "filterScope": "Mine",
      "label": "My Activities"
    },
    {
      "fullName": "TodaysTasks",
      "filterScope": "Mine",
      "filters": [
        {
          "field": "ACTIVITY.TASK",
          "operation": "equals",
          "value": "1"
        },
        {
          "field": "TASK.CLOSED",
          "operation": "equals",
          "value": "0"
        },
        {
          "field": "TASK.DUE_DATE",
          "operation": "lessThan",
          "value": "TOMORROW"
        }
      ],
      "label": "Today's Tasks"
    },
    {
      "fullName": "UpcomingEvents",
      "filterScope": "Mine",
      "filters": [
        {
          "field": "ACTIVITY.TASK",
          "operation": "equals",
          "value": "0"
        },
        {
          "field": "TASK.DUE_DATE",
          "operation": "greaterThan",
          "value": "YESTERDAY"
        }
      ],
      "label": "Upcoming Events"
    }
  ],
  "searchLayouts": {
    "searchResultsAdditionalFields": [
      "TASK.SUBJECT",
      "TASK.WHO_NAME",
      "TASK.WHAT_NAME",
      "TASK.DUE_DATE",
      "CORE.USERS.ALIAS"
    ]
  },
  "sharingModel": "Private"
}