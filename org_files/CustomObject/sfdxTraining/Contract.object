      "type": "Lookup"
    },
    {
      "fullName": "ActivatedById",
      "trackHistory": "false",
      "type": "Lookup"
    },
    {
      "fullName": "ActivatedDate",
      "trackHistory": "false"
    },
    {
      "fullName": "BillingAddress",
      "trackHistory": "true"
    },
    {
      "fullName": "CompanySignedDate",
      "trackHistory": "true"
    },
    {
      "fullName": "CompanySignedId",
      "trackHistory": "true",
      "type": "Lookup"
    },
    {
      "fullName": "ContractTerm",
      "trackHistory": "true"
    },
    {
      "fullName": "CustomerSignedDate",
      "trackHistory": "true"
    },
    {
      "fullName": "CustomerSignedId",
      "trackHistory": "true",
      "type": "Lookup"
    },
    {
      "fullName": "CustomerSignedTitle",
      "trackHistory": "true"
    },
    {
      "fullName": "Description",
      "trackHistory": "true"
    },
    {
