      "trackHistory": "true"
    },
    {
      "fullName": "StartDate",
      "trackHistory": "true"
    },
    {
      "fullName": "Status",
      "trackHistory": "true",
      "type": "Picklist"
    }
  ],
  "label": "Contract",
  "listViews": [
    {
      "fullName": "AllActivatedContracts",
      "filterScope": "Everything",
      "filters": {
        "field": "CONTRACT.STATUS_CODE",
        "operation": "equals",
        "value": "A"
      },
      "label": "All Activated Contracts"
    },
    {
      "fullName": "AllContracts",
      "filterScope": "Everything",
      "label": "All Contracts"
    },
    {
      "fullName": "AllDraftContracts",
      "filterScope": "Everything",
      "filters": {
        "field": "CONTRACT.STATUS_CODE",
        "operation": "equals",
        "value": "D"
      },
      "label": "All Draft Contracts"
    },
    {
      "fullName": "AllInApprovalContracts",
      "filterScope": "Everything",
      "filters": {
        "field": "CONTRACT.STATUS_CODE",
        "operation": "equals",
        "value": "P"
      },
      "label": "All In Approval Contracts"
    },
    {
      "fullName": "MyActivatedContracts",
      "filterScope": "Mine",
      "filters": {
        "field": "CONTRACT.STATUS_CODE",
        "operation": "equals",
        "value": "A"
      },
      "label": "My Activated Contracts"
    },
    {
      "fullName": "MyDraftContracts",
      "filterScope": "Mine",
      "filters": {
        "field": "CONTRACT.STATUS_CODE",
        "operation": "equals",
        "value": "D"
      },
      "label": "My Draft Contracts"
    },
    {
      "fullName": "MyInApprovalContracts",
      "filterScope": "Mine",
      "filters": {
        "field": "CONTRACT.STATUS_CODE",
        "operation": "equals",
        "value": "P"
      },
      "label": "My In Approval Contracts"
    }
  ],
  "searchLayouts": {
    "customTabListAdditionalFields": [
      "CONTRACT.CONTRACT_NUMBER",
      "SALES.ACCOUNT.NAME",
      "CONTRACT.STATUS"
    ],
    "lookupDialogsAdditionalFields": [
      "CONTRACT.CONTRACT_NUMBER",
      "CORE.USERS.ALIAS"
    ],
    "lookupPhoneDialogsAdditionalFields": [
      "CONTRACT.CONTRACT_NUMBER",
      "CORE.USERS.ALIAS"
    ],
    "searchResultsAdditionalFields": [
      "CONTRACT.CONTRACT_NUMBER",
      "SALES.ACCOUNT.NAME",
      "CONTRACT.STATUS",
      "CONTRACT.START_DATE",
      "CONTRACT.END_DATE",
      "CONTRACT_TERM"
    ]
  },
  "sharingModel": "ReadWrite"
}