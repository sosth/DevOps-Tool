  "label": "Service Appointment",
  "listViews": [
    {
      "fullName": "All_ServiceAppointments",
      "columns": [
        "Name",
        "SchedStartTime",
        "SchedEndTime",
        "ServiceTerritory",
        "Status",
        "WorkTypeName",
        "WorkType",
        "AdditionalInformation",
        "Account",
        "ParentRecord"
      ],
      "filterScope": "Everything",
      "label": "All Service Appointments"
    },
    {
      "fullName": "MyPendingAppointments",
      "columns": [
        "Name",
        "SchedStartTime",
        "SchedEndTime",
        "ServiceTerritory",
        "Status",
        "WorkTypeName",
        "WorkType",
        "AdditionalInformation",
        "Account",
        "ParentRecord"
      ],
      "filterScope": "Mine",
      "filters": [
        {
          "field": "SchedStartTime",
          "operation": "equals"
        },
        {
          "field": "StatusCategory",
          "operation": "equals",
          "value": "0"
        }
      ],
      "label": "My Pending Service Appointments"
    },
    {
      "fullName": "MyScheduledAppointments",
      "columns": [
        "Name",
        "SchedStartTime",
        "SchedEndTime",
        "ServiceTerritory",
        "Status",
        "WorkTypeName",
        "WorkType",
        "AdditionalInformation",
        "Account",
        "ParentRecord"
      ],
      "filterScope": "Mine",
      "filters": [
        {
          "field": "SchedStartTime",
          "operation": "greaterOrEqual",
          "value": "TODAY"
        },
        {
          "field": "StatusCategory",
          "operation": "notEqual",
          "value": "6,4,5"
        }
      ],
      "label": "My Scheduled Service Appointments"
    }
  ],
  "searchLayouts": {
    "customTabListAdditionalFields": [
      "ParentRecord",
      "ParentRecordType",
      "Status",
      "ArrivalWindowStartTime",
      "ArrivalWindowEndTime"
    ],
