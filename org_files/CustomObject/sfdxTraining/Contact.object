  "label": "Contact",
  "listViews": [
    {
      "fullName": "AllContacts",
      "filterScope": "Everything",
      "label": "All Contacts"
    },
    {
      "fullName": "BirthdaysThisMonth",
      "filterScope": "Everything",
      "filters": {
        "field": "CONTACT.BIRTHDATE",
        "operation": "equals",
        "value": "THIS_MONTH"
      },
      "label": "Birthdays This Month"
    },
    {
      "fullName": "BulkMessageContacts",
      "columns": [
        "FULL_NAME",
        "ACCOUNT.NAME",
        "CONTACT.PHONE3",
        "CONTACT.LAST_ACTIVITY"
      ],
      "filterScope": "Everything",
      "label": "Bulk_SMS_Contacts"
    },
    {
      "fullName": "MyContacts",
      "filterScope": "Mine",
      "label": "My Contacts"
    },
    {
      "fullName": "NewLastWeek",
      "filterScope": "Everything",
      "filters": {
        "field": "CONTACT.CREATED_DATE",
        "operation": "equals",
        "value": "LAST_WEEK"
      },
      "label": "New Last Week"
    },
    {
      "fullName": "NewThisWeek",
      "filterScope": "Everything",
      "filters": {
        "field": "CONTACT.CREATED_DATE",
        "operation": "equals",
        "value": "THIS_WEEK"
      },
      "label": "New This Week"
    }
  ],
