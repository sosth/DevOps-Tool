  "label": "Cart",
  "listViews": [
    {
      "fullName": "All_WebCarts",
      "columns": [
        "Name",
        "CreatedDate",
        "GrandTotalAmount",
        "Status",
        "Owner",
        "Account"
      ],
      "filterScope": "Everything",
      "filters": [
        {
          "field": "Status",
          "operation": "equals",
          "value": "A"
        },
        {
          "field": "Type",
          "operation": "equals",
          "value": "C"
        }
      ],
      "label": "All Active Carts"
    },
    {
      "fullName": "Owned_WebCarts",
      "columns": [
        "Name",
        "CreatedDate",
        "GrandTotalAmount",
        "Status",
        "Account"
      ],
      "filterScope": "Mine",
      "filters": [
        {
          "field": "Status",
          "operation": "equals",
          "value": "A"
        },
        {
          "field": "Type",
          "operation": "equals",
          "value": "C"
        }
      ],
      "label": "My Active Carts"
    }
  ],
