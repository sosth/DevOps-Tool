  "label": "Case",
  "listViews": [
    {
      "fullName": "AllClosedCases",
      "columns": [
        "CASES.CASE_NUMBER",
        "NAME",
        "CASES.SUBJECT",
        "CASES.STATUS",
        "CASES.PRIORITY",
        "CASES.CREATED_DATE",
        "CORE.USERS.ALIAS"
      ],
      "filterScope": "Everything",
      "filters": {
        "field": "CASES.CLOSED",
        "operation": "equals",
        "value": "1"
      },
      "label": "All Closed Cases"
    },
    {
      "fullName": "AllOpenCases",
      "filterScope": "Everything",
      "filters": [
        {
          "field": "CASES.CREATED_DATE_DATE_ONLY",
          "operation": "equals",
          "value": "LAST_N_DAYS:30"
        },
        {
          "field": "CASES.CLOSED",
          "operation": "equals",
          "value": "0"
        }
      ],
      "label": "All Open Cases"
    },
    {
      "fullName": "MyCases",
      "filterScope": "Mine",
      "label": "My Cases"
    },
    {
      "fullName": "MyOpenCases",
      "filterScope": "Mine",
      "filters": {
        "field": "CASES.CLOSED",
        "operation": "equals",
        "value": "0"
      },
      "label": "My Open Cases"
    }
  ],
