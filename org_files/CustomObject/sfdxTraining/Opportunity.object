  ],
  "label": "Opportunity",
  "listViews": [
    {
      "fullName": "AllOpportunities",
      "filterScope": "Everything",
      "label": "All Opportunities"
    },
    {
      "fullName": "ClosingNextMonth",
      "filterScope": "Everything",
      "filters": [
        {
          "field": "OPPORTUNITY.CLOSED",
          "operation": "equals",
          "value": "0"
        },
        {
          "field": "OPPORTUNITY.CLOSE_DATE",
          "operation": "equals",
          "value": "NEXT_MONTH"
        }
      ],
      "label": "Closing Next Month"
    },
    {
      "fullName": "ClosingThisMonth",
      "filterScope": "Everything",
      "filters": [
        {
          "field": "OPPORTUNITY.CLOSED",
          "operation": "equals",
          "value": "0"
        },
        {
          "field": "OPPORTUNITY.CLOSE_DATE",
          "operation": "equals",
          "value": "THIS_MONTH"
        }
      ],
      "label": "Closing This Month"
    },
    {
      "fullName": "Default_Opportunity_Pipeline",
      "filterScope": "Mine",
      "filters": {
        "field": "OPPORTUNITY.CLOSE_DATE",
        "operation": "greaterOrEqual",
        "value": "LAST_N_MONTHS:3"
      },
      "label": "Opportunity Pipeline"
    },
    {
      "fullName": "MyOpportunities",
      "filterScope": "Mine",
      "label": "My Opportunities"
    },
    {
      "fullName": "NewLastWeek",
      "filterScope": "Everything",
      "filters": {
        "field": "OPPORTUNITY.CREATED_DATE",
        "operation": "equals",
        "value": "LAST_WEEK"
      },
      "label": "New Last Week"
    },
    {
      "fullName": "NewThisWeek",
      "filterScope": "Everything",
      "filters": {
        "field": "OPPORTUNITY.CREATED_DATE",
        "operation": "equals",
        "value": "THIS_WEEK"
      },
      "label": "New This Week"
    },
    {
      "fullName": "Private",
      "filterScope": "Everything",
      "filters": {
        "field": "OPPORTUNITY.PRIVATE",
        "operation": "equals",
        "value": "1"
      },
      "label": "Private"
    },
    {
      "fullName": "Won",
      "filterScope": "Everything",
      "filters": [
        {
          "field": "OPPORTUNITY.CLOSED",
          "operation": "equals",
          "value": "1"
        },
        {
          "field": "OPPORTUNITY.WON",
          "operation": "equals",
          "value": "1"
        }
      ],
      "label": "Won"
    }
  ],
  "searchLayouts": {
    "customTabListAdditionalFields": [
      "OPPORTUNITY.NAME",
      "ACCOUNT.NAME",
      "OPPORTUNITY.CLOSE_DATE"
    ],
    "lookupDialogsAdditionalFields": [
      "OPPORTUNITY.NAME",
      "ACCOUNT.NAME",
      "ACCOUNT.SITE"
    ],
    "lookupPhoneDialogsAdditionalFields": [
      "OPPORTUNITY.NAME",
      "ACCOUNT.NAME",
      "ACCOUNT.SITE"
    ],
    "searchResultsAdditionalFields": [
      "OPPORTUNITY.NAME",
      "ACCOUNT.NAME",
      "ACCOUNT.SITE",
      "OPPORTUNITY.STAGE_NAME",
      "OPPORTUNITY.CLOSE_DATE",
      "CORE.USERS.ALIAS"
    ]
  },
  "sharingModel": "ReadWrite",
  "webLinks": {
    "fullName": "DeliveryStatus",
    "availability": "online",
    "displayType": "link",
    "encodingKey": "UTF-8",
    "hasMenubar": "true",
    "hasScrollbars": "true",
    "hasToolbar": "true",
    "height": "600",
    "isResizable": "true",
    "linkType": "url",
    "masterLabel": "Delivery Status",
    "openType": "newWindow",
    "position": "none",
    "protected": "false",
    "showsLocation": "true",
    "showsStatus": "true",
    "url": "http://www.fedex.com/cgi-bin/tracking?tracknumbers={!Opportunity_Tracking_Number}&action=track&language=english&cntry_code=us"
  }
}