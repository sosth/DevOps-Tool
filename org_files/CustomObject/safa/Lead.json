  "label": "Lead",
  "listViews": [
    {
      "fullName": "AllOpenLeads",
      "filterScope": "Everything",
      "filters": {
        "field": "LEAD.STATUS",
        "operation": "notContain",
        "value": "closed"
      },
      "label": "All Open Leads"
    },
    {
      "fullName": "MyUnreadLeads",
      "filterScope": "Mine",
      "filters": {
        "field": "LEAD.UNREAD",
        "operation": "equals",
        "value": "1"
      },
      "label": "My Unread Leads"
    },
    {
      "fullName": "TodaysLeads",
      "filterScope": "Everything",
      "filters": {
        "field": "LEAD.CREATED_DATE",
        "operation": "equals",
        "value": "TODAY"
      },
      "label": "Today's Leads"
    },
    {
      "fullName": "ViewCustom1",
      "columns": [
        "FULL_NAME",
        "LEAD.COMPANY",
        "LEAD.STATE",
        "LEAD.EMAIL",
        "LEAD.STATUS",
        "LEAD.CREATED_DATE",
        "CORE.USERS.ALIAS",
        "LEAD.UNREAD"
      ],
      "filterScope": "Everything",
      "label": "View - Custom 1"
    },
    {
      "fullName": "ViewCustom2",
