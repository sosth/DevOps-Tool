    {
      "fullName": "TodaysTasks",
      "filterScope": "Mine",
      "filters": [
        {
          "field": "ACTIVITY.TASK",
          "operation": "equals",
          "value": "1"
        },
        {
          "field": "TASK.CLOSED",
          "operation": "equals",
          "value": "0"
        },
        {
          "field": "TASK.DUE_DATE",
          "operation": "lessThan",
          "value": "TOMORROW"
        }
      ],
      "label": "Today's Tasks"
    },
    {
      "fullName": "UpcomingEvents",
      "filterScope": "Mine",
      "filters": [
        {
          "field": "ACTIVITY.TASK",
          "operation": "equals",
          "value": "0"
        },
        {
          "field": "TASK.DUE_DATE",
          "operation": "greaterThan",
          "value": "YESTERDAY"
        }
      ],
      "label": "Upcoming Events"
    }
  ],
