{
  "name": "my-salesforce-app",
  "version": "1.0.0",
  "description": "A simple Salesforce app with OAuth2 and SFDX integration",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "heroku-postbuild": "cd frontend && npm install && npm run build",
    "dev": "concurrently \"nodemon app.js\" \"cd frontend && npm start\""
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^10.0.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "fs": "0.0.1-security",
    "google-auth-library": "^9.12.0",
    "jsforce": "^1.11.1",
    "mysql": "^2.18.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "path": "^0.12.7",
    "pg": "^8.12.0",
    "postgresql": "0.0.1",
    "psl": "^1.9.0",
    "react-icons": "^5.2.1",
    "simple-oauth2": "^4.3.0",
    "sqlite3": "^5.1.7",
    "xml-js": "^1.6.11",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "nodemon": "^2.0.22"
  },
  "engines": {
    "node": "18.x"
  }
}